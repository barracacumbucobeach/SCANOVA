# Build outputs
bin/
obj/
publish/
artifacts/

# Saída gerada pelo instalador (Fase 11) — o código-fonte do projeto (installer/*.wixproj,
# *.wxs, *.ps1) É versionado; só os artefatos que ele produz não são.
installer/**/bin/
installer/**/obj/
installer/**/*.msi
installer/**/*.wixpdb
installer/**/*.sha256

# Visual Studio / Rider
.vs/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser
.idea/

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml

# NuGet
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/

# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store

# Logs, temporários e dados locais gerados em runtime — nunca versionar (seção 47, 59, 121)
Logs/
Temp/
*.log

# Segredos e chaves — nunca versionar (seção 120, 121)
*.pfx
*.snk
*.pem
*.key
secrets.json
appsettings.local.json
.env
.env.*

# Documentos de teste com dados pessoais nunca devem ser versionados (seção 122);
# arquivos sintéticos de teste ficam em tests/**/TestData e são versionados normalmente.
