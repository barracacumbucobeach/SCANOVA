<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Só depende de SCANOVA.Core: IImageLoader/IImageExporter/IDocumentEnhancementService/
         ITiffDocumentPipeline/ITiffEncoder/IPdfService são interfaces (Core), a implementação
         concreta é resolvida pela injeção de dependência no composition root — mesmo padrão de
         SCANOVA.Pdf dependendo apenas de ITiffEncoder sem referenciar SCANOVA.Tiff. -->
    <ProjectReference Include="..\SCANOVA.Core\SCANOVA.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
