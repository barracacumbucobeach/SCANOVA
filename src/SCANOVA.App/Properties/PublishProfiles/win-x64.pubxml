<Project>
  <!--
    Perfil de publicação usado pelo instalador (Fase 11, seção 91) — gera um executável
    autocontido (não exige o runtime do .NET nem o Windows App SDK pré-instalados na máquina do
    cliente): tudo que é preciso para rodar o SCANOVA já vai dentro da pasta publicada. Só a
    arquitetura x64 é coberta por este perfil; win-arm64/win-x86 podem ganhar perfis análogos
    quando houver demanda real (o .csproj já declara as três RuntimeIdentifiers).

    Uso: dotnet publish src\SCANOVA.App -c Release -p:PublishProfile=win-x64
    (só funciona no Windows — ver docs/BUILD.md).
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishDir>bin\publish\win-x64</PublishDir>
  </PropertyGroup>
</Project>
