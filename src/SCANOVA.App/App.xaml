<Application
    x:Class="SCANOVA.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:SCANOVA.App.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Styles/Cards.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:BoolToInfoBarSeverityConverter x:Key="BoolToInfoBarSeverityConverter" />

            <!-- Cor de marca principal do SCANOVA (seção 8: cor principal + tons neutros + estados semânticos). -->
            <Color x:Key="ScanovaBrandColor">#1F4FD8</Color>
            <SolidColorBrush x:Key="ScanovaBrandBrush" Color="{StaticResource ScanovaBrandColor}" />

            <Color x:Key="ScanovaSuccessColor">#1E8E3E</Color>
            <SolidColorBrush x:Key="ScanovaSuccessBrush" Color="{StaticResource ScanovaSuccessColor}" />

            <Color x:Key="ScanovaWarningColor">#B45309</Color>
            <SolidColorBrush x:Key="ScanovaWarningBrush" Color="{StaticResource ScanovaWarningColor}" />

            <Color x:Key="ScanovaErrorColor">#C4281C</Color>
            <SolidColorBrush x:Key="ScanovaErrorBrush" Color="{StaticResource ScanovaErrorColor}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
