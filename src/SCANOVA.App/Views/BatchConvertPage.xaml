<Page
    x:Class="SCANOVA.App.Views.BatchConvertPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="32,24,32,24" Spacing="20">

            <StackPanel Spacing="4">
                <TextBlock Text="Converter em lote" Style="{ThemeResource TitleLargeTextBlockStyle}" />
                <TextBlock
                    Text="Escolha vários arquivos de imagem, uma pasta de destino e um formato de saída — cada arquivo vira um documento independente, na mesma pasta, com o mesmo nome (só muda a extensão)."
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8" IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}">
                <TextBlock Text="Arquivos" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.FileCount, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ListView ItemsSource="{x:Bind ViewModel.SourceFileNames}" Height="140" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Adicionar arquivos" Command="{x:Bind ViewModel.AddFilesCommand}" />
                    <Button Content="Limpar" Command="{x:Bind ViewModel.ClearFilesCommand}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8" IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}">
                <TextBlock Text="Pasta de destino" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.DestinationFolder, Mode=OneWay}" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                <Button Content="Escolher pasta" Command="{x:Bind ViewModel.PickDestinationFolderCommand}" />
            </StackPanel>

            <StackPanel Spacing="8" IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}">
                <ComboBox
                    Header="Formato de saída"
                    ItemsSource="{x:Bind ViewModel.Formats}"
                    SelectedItem="{x:Bind ViewModel.SelectedFormat, Mode=TwoWay}"
                    DisplayMemberPath="Label"
                    HorizontalAlignment="Stretch" />

                <ToggleSwitch Header="Melhorar automaticamente" IsOn="{x:Bind ViewModel.EnhanceAutomatically, Mode=TwoWay}" OnContent="Sim" OffContent="Não" />
                <ToggleSwitch Header="Sobrescrever arquivos existentes" IsOn="{x:Bind ViewModel.OverwriteExisting, Mode=TwoWay}" OnContent="Sim" OffContent="Não" />
            </StackPanel>

            <Button
                Content="Iniciar conversão"
                Command="{x:Bind ViewModel.StartCommand}"
                Style="{ThemeResource AccentButtonStyle}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />

            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ProgressBar Value="{x:Bind ViewModel.ProcessedCount, Mode=OneWay}" Maximum="{x:Bind ViewModel.TotalCount, Mode=OneWay}" />
                <TextBlock
                    Text="{x:Bind ViewModel.ProgressStatusText, Mode=OneWay}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Content="Pausar"
                        Command="{x:Bind ViewModel.PauseCommand}"
                        Visibility="{x:Bind ViewModel.IsPaused, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                    <Button
                        Content="Retomar"
                        Command="{x:Bind ViewModel.ResumeCommand}"
                        Visibility="{x:Bind ViewModel.IsPaused, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button Content="Cancelar" Command="{x:Bind ViewModel.CancelCommand}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasReport, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Relatório" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.ReportSummary, Mode=OneWay}" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                <ListView
                    ItemsSource="{x:Bind ViewModel.FailedItems}"
                    Visibility="{x:Bind ViewModel.HasFailedItems, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Height="120"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
