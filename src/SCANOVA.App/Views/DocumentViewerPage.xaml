<Page
    x:Class="SCANOVA.App.Views.DocumentViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <CommandBar.Content>
                <TextBlock Text="{x:Bind ViewModel.DocumentTitle, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" Margin="16,0,0,0" />
            </CommandBar.Content>

            <AppBarButton Label="Girar à esquerda" Command="{x:Bind ViewModel.RotateLeftCommand}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE7AD;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Girar à direita" Command="{x:Bind ViewModel.RotateRightCommand}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE7AC;" />
                </AppBarButton.Icon>
            </AppBarButton>

            <AppBarSeparator />

            <AppBarToggleButton Label="Cortar" IsChecked="{x:Bind ViewModel.IsCropMode, Mode=OneWay}" Click="CropToggle_Click">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE7A8;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarButton
                Label="Aplicar corte"
                Command="{x:Bind ViewModel.ApplyCropCommand}"
                Visibility="{x:Bind ViewModel.IsCropMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE73E;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                Label="Cancelar corte"
                Command="{x:Bind ViewModel.CancelCropCommand}"
                Visibility="{x:Bind ViewModel.IsCropMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE711;" />
                </AppBarButton.Icon>
            </AppBarButton>

            <AppBarSeparator />

            <AppBarButton Label="Melhorar automaticamente" Command="{x:Bind ViewModel.EnhanceAutomaticallyCommand}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE945;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Reverter para original" Command="{x:Bind ViewModel.RevertToOriginalCommand}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE7A7;" />
                </AppBarButton.Icon>
            </AppBarButton>

            <AppBarSeparator />

            <AppBarButton Label="Ajustar à tela" Click="FitToScreen_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE9A6;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Tamanho real (1:1)" Click="ActualSize_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE71E;" />
                </AppBarButton.Icon>
            </AppBarButton>

            <CommandBar.SecondaryCommands>
                <AppBarButton Label="Salvar como" Command="{x:Bind ViewModel.SaveAsCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE792;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <ScrollViewer
            x:Name="Viewer"
            Grid.Row="1"
            ZoomMode="Enabled"
            MinZoomFactor="0.05"
            MaxZoomFactor="6"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            VerticalScrollMode="Enabled"
            Background="{ThemeResource LayerFillColorAltBrush}">

            <Grid
                x:Name="ImageHost"
                Background="Transparent"
                PointerPressed="ImageHost_PointerPressed"
                PointerMoved="ImageHost_PointerMoved"
                PointerReleased="ImageHost_PointerReleased"
                PointerCanceled="ImageHost_PointerReleased">

                <Image x:Name="MainImage" Source="{x:Bind ViewModel.DisplayBitmap, Mode=OneWay}" Stretch="None" />

                <Canvas x:Name="CropCanvas" IsHitTestVisible="False">
                    <Rectangle
                        x:Name="CropRectangle"
                        Stroke="{ThemeResource ScanovaBrandBrush}"
                        StrokeThickness="2"
                        StrokeDashArray="4,3"
                        Fill="#330A66FF"
                        Visibility="Collapsed" />
                </Canvas>
            </Grid>
        </ScrollViewer>

        <ProgressRing
            Grid.Row="1"
            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
    </Grid>
</Page>
