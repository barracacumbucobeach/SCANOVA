<Page
    x:Class="SCANOVA.App.Views.OcrPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid MaxWidth="1000" HorizontalAlignment="Left" Margin="32,24,32,24" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Extrair texto (OCR)" Style="{ThemeResource TitleLargeTextBlockStyle}" />
                    <TextBlock
                        Text="Reconhece o texto de um documento digitalizado, direto no seu computador — nada é enviado para a internet."
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Text="{x:Bind ViewModel.DocumentTitle, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />

                <Border
                    Height="200"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Visibility="{x:Bind ViewModel.HasDocument, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Image Source="{x:Bind ViewModel.PreviewBitmap, Mode=OneWay}" Stretch="Uniform" Margin="4" AutomationProperties.AccessibilityView="Raw" />
                </Border>

                <Button Content="Abrir documento" Command="{x:Bind ViewModel.OpenDocumentCommand}" HorizontalAlignment="Stretch" />

                <ComboBox
                    Header="Idioma do documento"
                    ItemsSource="{x:Bind ViewModel.Languages}"
                    SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}"
                    DisplayMemberPath="Label"
                    HorizontalAlignment="Stretch" />

                <Button
                    Content="Reconhecer texto"
                    Command="{x:Bind ViewModel.RecognizeTextCommand}"
                    Style="{ThemeResource AccentButtonStyle}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />

                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20" />
                    <TextBlock Text="Processando..." Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="12">
                <TextBlock Text="Texto reconhecido" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    Text="Revise e corrija o texto abaixo antes de salvar — a correção não altera a imagem original."
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />

                <TextBox
                    Text="{x:Bind ViewModel.RecognizedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    Height="420"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    FontFamily="Consolas" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Salvar como TXT" Command="{x:Bind ViewModel.SaveAsTxtCommand}" />
                    <Button Content="Salvar como Word (DOCX)" Command="{x:Bind ViewModel.SaveAsDocxCommand}" />
                    <Button Content="Salvar como PDF pesquisável" Command="{x:Bind ViewModel.SaveAsSearchablePdfCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
